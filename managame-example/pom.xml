<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>cn.managame</groupId>
  <artifactId>managame-example</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <description>
    A small game, a world server and a game server, joining every component in its own code. An example to copy from:
    nothing depends on it, and it is never installed.
  </description>

  <properties>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <!-- As an application takes several components: one version from the BOM, none per component. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>cn.managame</groupId>
        <artifactId>managame-bom</artifactId>
        <version>${project.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency><groupId>cn.managame</groupId><artifactId>managame-common</artifactId></dependency>
    <dependency><groupId>cn.managame</groupId><artifactId>managame-network</artifactId></dependency>
    <dependency><groupId>cn.managame</groupId><artifactId>managame-runtime</artifactId></dependency>
    <dependency><groupId>cn.managame</groupId><artifactId>managame-rpc</artifactId></dependency>
    <dependency><groupId>cn.managame</groupId><artifactId>managame-data</artifactId></dependency>
    <dependency><groupId>cn.managame</groupId><artifactId>managame-data-mysql</artifactId></dependency>
    <!-- The example's database: H2 in MySQL mode, in memory. A real game uses MySQL's driver and a pool. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.3.232</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>example</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>cn.managame.example.ExampleMain</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
